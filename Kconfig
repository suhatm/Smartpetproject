# LIHAObohuan 宠物环 应用配置

config APP_POWER_DOMAIN_SELFTEST
	bool "Boot-time power domain self-test"
	default y
	help
	  开机自检阶段依次单独打开/关闭三路电源域（SENS/STORE/ANALOG）
	  并回读校验，通过 RTT 打印 PASS/FAIL，用于验证三域独立控制。
	  量产固件可关闭以缩短开机时间。

config APP_BOOT_LED_INDICATION
	bool "Boot/ready LED indication (3 s patterns)"
	default y
	help
	  开机 LED0(红) 闪烁 3 秒、就绪 LED0+LED1 同闪 3 秒的开机灯效。
	  关闭后跳过灯效直接进入主循环（关机蓝闪不受此开关影响）。

config APP_SHUTDOWN_HOLD_MS
	int "Power-off hold time (ms)"
	default 3000
	range 1000 9000
	help
	  关机判定时长：按住达到该时长后松开才触发优雅关机
	  （防佩戴误触，产品方案 §5.2）。

config APP_SHORT_PRESS_MAX_MS
	int "Short-press upper bound (ms)"
	default 1000
	range 100 2000
	help
	  松开时按住时长小于该值视为短按（状态确认，蓝灯双闪）。

config APP_LED_BLINK_PERIOD_MS
	int "LED blink half period (ms)"
	default 300
	range 50 1000
	help
	  3 秒指示图案的亮/灭半周期（默认 300 ms on / 300 ms off）。

config APP_LED_INDICATION_MS
	int "LED indication duration (ms)"
	default 3000
	range 500 10000
	help
	  开机/关机/就绪指示图案的持续时长（默认 3 秒）。

config APP_HEARTBEAT_LED
	bool "Heartbeat LED indication during normal operation"
	default y
	help
	  正常工作（ACTIVE）期间的心跳指示：LED0+LED1 同时快闪一下，
	  周期与时长可配（APP_HEARTBEAT_PERIOD_MS / APP_HEARTBEAT_FLASH_MS）。
	  用于"设备正在工作"的持续可见指示；关闭后正常工作期间灯全灭
	  （最省电）。注意：心跳指示与省电存在权衡，默认开启满足
	  "正常工作可见"的产品需求，量产可按需关闭。

config APP_HEARTBEAT_PERIOD_MS
	int "Heartbeat period (ms)"
	default 5000
	range 1000 60000
	depends on APP_HEARTBEAT_LED
	help
	  心跳指示的重复周期（默认每 5 秒闪一次）。

config APP_HEARTBEAT_FLASH_MS
	int "Heartbeat flash duration (ms)"
	default 100
	range 20 500
	depends on APP_HEARTBEAT_LED
	help
	  心跳单次闪烁的点亮时长（默认 100 ms，双灯同亮）。

config APP_IMU_TEST
	bool "IMU (U4 LSM6DSV16X) I2C bring-up self-test"
	default y
	help
	  IMU 连通性自检（task-V1.03，docs/IMU采集测试方案.md）：
	  NFC pad 归还（P1.02/P1.03 -> GPIO，NFCT.PADCONFIG 运行时写 0）、
	  VDD_SENS_3V0 上电、SENS_I2C（i2c21）总线扫描、
	  U4 WHO_AM_I 校验（0x0F，期望 0x70，两个候选地址 0x6A/0x6B）。
	  自检完成后 SENS 电源域下电，结果经 RTT 打印 IMU_TEST,summary。
	  量产固件可关闭以缩短开机时间。

config APP_POWER_DOMAIN_TEST_MB
	bool "SWD test mailbox for power domain control (host tool)"
	default y
	help
	  SWD 测试邮箱：上位机（tools/power_domain_test.py）经调试器
	  直接读写 RAM 邮箱（符号 power_test_mb，地址见 zephyr.map），
	  下发三电源域独立开关命令（SENS/STORE/ANA 单独开、关、
	  全开、全关、状态查询）。仅调试用，量产固件应关闭。

config APP_BLE_LED_TEST
	bool "BLE peripheral LED control test service (nRF Connect App)"
	depends on BT
	default y
	help
	  蓝牙从机 LED 测试服务（docs/蓝牙驱动测试方案.md，task-V1.02）：
	  广播名 SmartPet，自定义 GATT 服务
	  e5a00001-1e5c-4b8f-9a2d-6c0f7e8d9a0b，特征值 e5a00002
	  （Read/Write，1 字节位图：bit0=LED0红 bit1=LED1蓝）。
	  手机 nRF Connect App 连接后可控制两灯开关。
	  不影响原有 LED 状态机：BLE 显示层优先级低于故障/按键/充电，
	  仅在 ACTIVE 空闲态覆盖心跳层；断开连接自动清除。
	  注意：量产固件应置 n（省电；且当前免配对明文写入有安全风险）。

config APP_BLE_IMU_STREAM
	bool "BLE peripheral IMU data stream service (nRF Connect App)"
	depends on BT && SENSOR
	default y
	help
	  蓝牙从机 IMU 数据流服务（task-V1.03，docs/IMU采集测试方案.md §4）：
	  自定义 GATT 服务 e5a00010-1e5c-4b8f-9a2d-6c0f7e8d9a0b，
	  数据流特征值 e5a00011（Read/Notify，[seq][cnt][N×12B 帧]，
	  accel=mg / gyro=dps×10，MTU 自适应最多 20 帧/包）、
	  控制点 e5a00012（Read/Write，0x01 启动 / 0x00 停止）。
	  采集通路：U4 st,lsm6dsv16x 驱动（deferred-init，上电后手动
	  device_init）+ INT1(P0.00) drdy 触发（失败降级 33ms 轮询）
	  + 64 帧 k_msgq 环形缓冲 + 50ms 打包 notify。
	  断开连接自动停止采集。量产固件应置 n（省电 + 明文无安全）。

config APP_IMU_AUTOSTART
	bool "Auto-start IMU stream on BLE connect"
	depends on APP_BLE_IMU_STREAM
	default y
	help
	  连接即自动开始采集（断开自动停止）。

	  为什么默认开：控制点 e5a00012（写 0x01）和 Notify 订阅是两步操作，
	  而手机 App 上"先订阅还是先写控制点"的顺序很容易踩坑——
	  实测 nRF Connect for Mobile 上出现过"订阅(CCC=0x0001)后紧接着被
	  取消(CCC=0x0000)"（用户以为没反应就再点了一次下载箭头），
	  结果是采集在跑、数据全被丢（frames=64,dropped=11122），
	  手机端什么都看不到。自动开流后，App 只需订阅通知这一步即可见数据。

	  代价：连接期间持续 30Hz 采样（约 0.5 mA 量级），断电由断开自动停止
	  兜底。量产可按功耗预算置 n，保留控制点显式启停。

# 应用自定义 Kconfig 作为根文件时，必须引入 Zephyr 完整符号定义
source "Kconfig.zephyr"
