#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/sensor/lsm6dsv16x.h>
#include <zephyr/dt-bindings/sensor/lsm6dsvxxx.h>

/*
 * LIHAObohuan 宠物环主板（fubenxiangmu）电源/开关机/LED 设备树
 *
 * 关键硬件连接（对齐《元器件引脚及功能模块对应表》）：
 *   P1.07 <-> nPM1300 SDA   (PMIC_TWI = i2c22)
 *   P1.08 ->  nPM1300 SCL
 *   P0.03 <-  nPM1300 GPIO1 / PMIC_IRQ_N（R24 47k 外部上拉）
 *   P1.06 ->  TPS7A2030 EN / ANA_EN（注意：EVT0 为 P1.05，本板改 P1.06）
 */

/ {
	zephyr,user {
		/* 模拟电源域使能：TPS7A2030 EN，高有效，R25 100k 下拉默认关 */
		ana-enable-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * P1.02/P1.03 复位后默认为 NFC 天线 pad（NFCT.PADCONFIG 复位值 0x1=Enabled，
 * 且每次复位重新加载）。nRF54L 的归还机制与 nRF52 不同：
 *   - nRF52：UICR.NFCPINS（本芯片 UICR 无此寄存器）
 *   - nRF54L：运行时直接写 NFCT.PADCONFIG=0 即可归还为 GPIO，无需重启
 * 实际归还动作在 src/hardware/imu_sensor.c 的 PRE_KERNEL_1 初始化中完成，
 * 必须早于 i2c21 TWIM 的 pinctrl 应用。
 */
&nfct {
	nfct-pins-as-gpios;
};

/*
 * 关键：禁用 uart20（uart20 冲突规避，双保险之二）。
 * DK 板级 pinctrl 为 uart20 预定义了 TX=P1.04/RX=P1.05/RTS=P1.06/CTS=P1.07，
 * 与本板 IMU_REF_INT2/ADC_HEART/ANA_EN/PMIC_TWI_SDA 四脚全部冲突。
 */
&uart20 {
	status = "disabled";
};

&pinctrl {
	pet_pmic_i2c22_default: pet_pmic_i2c22_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 7)>,
				<NRF_PSEL(TWIM_SCL, 1, 8)>;
		};
	};

	pet_pmic_i2c22_sleep: pet_pmic_i2c22_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 7)>,
				<NRF_PSEL(TWIM_SCL, 1, 8)>;
			low-power-enable;
		};
	};
};

&i2c22 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&pet_pmic_i2c22_default>;
	pinctrl-1 = <&pet_pmic_i2c22_sleep>;
	pinctrl-names = "default", "sleep";

	npm1300_pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		status = "okay";

		/* nPM1300 GPOIRQ：空闲低电平，中断挂起期间为高 */
		host-int-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		pmic-int-pin = <1>;

		/* 从 Ship 模式唤醒需长按约 0.6 s */
		ship-to-active-time-ms = <608>;

		/* 保留 nPM1300 10 s 长按应急 power-cycle 复位 */
		long-press-reset = "one-button";
	};
};

&lfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <9000>;
};

&hfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <8000>;
};

/*
 * SENS_I2C（task-V1.03 IMU 采集）：P1.02=SDA / P1.03=SCL，4.7kΩ 上拉（R2/R4）。
 * 总线挂载：主板 U4 LSM6DSV16XTR（地址由 R6 0Ω 设 SA0）+
 * FPC1 柔性板（LSM6DSV16X + TMP112，地址由各自 0Ω 电阻区分）。
 * 400kHz Fast Mode：FIFO 批量读需要带宽余量。
 */
&pinctrl {
	pet_sens_i2c21_default: pet_sens_i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
		};
	};

	pet_sens_i2c21_sleep: pet_sens_i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&pet_sens_i2c21_default>;
	pinctrl-1 = <&pet_sens_i2c21_sleep>;
	pinctrl-names = "default", "sleep";

	/*
	 * 主板 IMU U4（LSM6DSV16XTR，task-V1.03 第二步）：
	 *   - 地址 0x6B：2026-10-01 板测实锤（R6 SA0=1 方向）
	 *   - zephyr,deferred-init：VDD_SENS_3V0（nPM1300 LDSW1）默认关闭，
	 *     驱动若在 POST_KERNEL 自动初始化会在无电状态下 whoami 失败；
	 *     改为上电后由 imu_stream.c 手动 device_init()
	 *   - INT1→P0.00（IMU_REF_INT1），drdy 触发采样
	 *   - 量程：±8g / 2000dps（宠物甩头奔跑场景，方案 §2）
	 *   - ODR 30Hz：BLE 传输与功耗平衡（后续经控制点可调）
	 */
	imu_u4: lsm6dsv16x@6b {
		compatible = "st,lsm6dsv16x";
		reg = <0x6b>;
		zephyr,deferred-init;
		accel-odr = <LSM6DSVXXX_DT_ODR_AT_30Hz>;
		accel-range = <LSM6DSV16X_DT_FS_8G>;
		gyro-odr = <LSM6DSVXXX_DT_ODR_AT_30Hz>;
		gyro-range = <LSM6DSV16X_DT_FS_2000DPS>;
		int1-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		drdy-pin = <1>;
		status = "okay";
	};
};
